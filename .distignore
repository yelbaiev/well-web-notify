# Files and folders to exclude from distribution ZIP
# Used by GitHub Actions release workflow

# Development folders
.git/
.github/
.claude/
.wordpress-org/

# Development files
.DS_Store
.gitignore
.distignore
*.md
!readme.txt

# Docs live in the repo, not in the plugin. `*.md` already drops the files;
# naming the directory stops empty docs/, docs/plans/ and docs/user-guide/
# folders (and any future screenshots in them) from riding along.
docs/

# IDE and editor files
.idea/
.vscode/
*.sublime-*

# Tooling scratch
.playwright-mcp/

# Testing
tests/
phpunit.xml
phpcs.xml

# Shell scripts
*.sh

# Other
node_modules/
composer.lock
package-lock.json
